# ---------------------------------------------------------------------------
# Water order system — environment. Copy to .env and fill in. NEVER commit .env.
# Switching to another bot (test → client) = change BOT_TOKEN only. No code changes.
# ---------------------------------------------------------------------------

NODE_ENV=development            # development | production
PORT=3020
HOST=127.0.0.1                  # 127.0.0.1 behind Nginx; 0.0.0.0 in Docker
LOG_LEVEL=info                  # fatal | error | warn | info | debug
APP_TIMEZONE=Asia/Tashkent      # business day for statistics and dates shown to people
API_URL=http://localhost:3020   # public https URL in production (webhook mode)
SWAGGER_ENABLED=true            # /api/docs; set false in production unless needed

DATABASE_URL=postgresql://water_bot:CHANGE_ME@localhost:5432/water_bot?schema=public

# Random secrets. Generate with:
#   APP_SECRET:      openssl rand -hex 32
#   ENCRYPTION_KEY:  openssl rand -base64 32   (32 bytes; required for amoCRM OAuth)
APP_SECRET=
ENCRYPTION_KEY=

# --- Telegram -------------------------------------------------------------
BOT_ENABLED=true
BOT_TOKEN=                      # from @BotFather
BOT_MODE=polling                # polling (no domain needed) | webhook (needs https API_URL)
BOT_WEBHOOK_SECRET=             # webhook mode only: 16-256 chars [A-Za-z0-9_-]
ADMIN_TELEGRAM_IDS=             # super admins, comma-separated numeric ids (e.g. 123456789,987654321)
ORDER_NOTIFY_CHAT_ID=           # optional: group/chat id that receives a copy of every order

# --- Location names (reverse geocoding) -----------------------------------
GEOCODER_PROVIDER=nominatim     # nominatim (free, no key) | yandex | none
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_EMAIL=                 # optional contact for the OSM usage policy
YANDEX_GEOCODER_API_KEY=        # required when GEOCODER_PROVIDER=yandex

# --- Product images -------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# --- amoCRM ---------------------------------------------------------------
# Leave empty to run without amoCRM: orders queue up and sync once it is configured.
AMOCRM_DOMAIN=                  # e.g. company.amocrm.ru (no https://)
# Option A — private integration, long-lived token (simplest):
AMOCRM_LONG_LIVED_TOKEN=
# Option B — OAuth2 (connect from the bot: ⚙️ Boshqaruv → 🔗 amoCRM):
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=            # https://api.example.com/api/amocrm/oauth/callback
AMOCRM_OAUTH_URL=https://www.amocrm.ru/oauth

AMOCRM_SYNC_ENABLED=true
AMOCRM_SYNC_MAX_ATTEMPTS=10

# Where new leads go (ids: run `npm run amocrm:inspect`). Empty = account defaults.
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
AMOCRM_RESPONSIBLE_USER_ID=
AMOCRM_LEAD_TAGS=telegram-bot

# Optional lead custom fields (numeric field ids). Unset fields are skipped;
# the full order is always added as a note on the lead.
AMOCRM_LEAD_FIELD_ORDER_NUMBER=
AMOCRM_LEAD_FIELD_CUSTOMER_NAME=
AMOCRM_LEAD_FIELD_PHONE=
AMOCRM_LEAD_FIELD_ADDRESS=
AMOCRM_LEAD_FIELD_MAP_LINK=
AMOCRM_LEAD_FIELD_PRODUCTS=
AMOCRM_LEAD_FIELD_QUANTITY=
AMOCRM_LEAD_FIELD_EMPTY_BOTTLES=
AMOCRM_LEAD_FIELD_TOTAL=
AMOCRM_LEAD_FIELD_TELEGRAM_ID=
AMOCRM_CONTACT_FIELD_TELEGRAM=
